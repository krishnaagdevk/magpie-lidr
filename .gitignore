# ==============================================================================
# Magpie LiDAR Monorepo .gitignore
# ==============================================================================

# Node / Web Studio (magpie-studio)
**/node_modules/
**/.pnpm-store/
**/.svelte-kit/
**/build/
**/dist/
**/.vite/
**/.vite-temp/

# Environment and Secrets
**/.env
**/.env.*
!**/.env.example
!**/.env.template
**/Secrets.swift
!**/Secrets.swift.template
**/*.pem
**/*.key

# Xcode / Swift / Apple (magpie-field & MagpieCore)
**/.build/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/
**/*.xcscmblueprint
**/project.xcworkspace/xcuserdata/
**/workspace.xcuserdatad/
**/*.playground/
**/*.ipa
**/*.dSYM.zip
**/*.dSYM

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# IDE and Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary and Test Artifacts
**/scratch/
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
**/*.tmp
**/*.temp
magpie-*.zip
