import Foundation

enum Secrets {
    static var apiKey: String? {
        return ProcessInfo.processInfo.environment["API_KEY"]
    }

    static var syncBackendURL: String? {
        return ProcessInfo.processInfo.environment["SYNC_BACKEND_URL"]
    }
}
